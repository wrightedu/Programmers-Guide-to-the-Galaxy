Bootstrap: docker
From: ubuntu:24.04

# Modern PyTorch + Miniconda container for the WSU CSE HPC cluster.
#
# Build (A100 / L40S / H200 nodes -- the default):
#   apptainer build --fakeroot pytorch.sif pytorch.def
#
# Build for the P100 node (Pascal GPUs need the older CUDA 12.6 wheels):
#   apptainer build --fakeroot --build-arg TORCH_CUDA=cu126 pytorch-p100.sif pytorch.def
#
# Run (always pass --nv so the host GPU driver is mounted in):
#   apptainer exec --nv pytorch.sif python my_script.py
#
# Notes:
# * The PyTorch pip wheels bundle their own CUDA runtime/cuDNN, so we do not
#   need an nvidia/cuda base image. The only CUDA piece that comes from the
#   host is the driver, which --nv provides. If you need nvcc to compile your
#   own CUDA extensions, change the base image to e.g.
#   nvidia/cuda:13.0.0-cudnn-devel-ubuntu24.04.
# * PyTorch no longer publishes conda packages, so conda manages Python and
#   the scientific stack while pip installs torch from download.pytorch.org.
# * conda is configured to use only conda-forge (no Anaconda "defaults"
#   channel), which avoids Anaconda's channel terms-of-service prompts.

%arguments
    PYTHON_VERSION=3.12
    TORCH_CUDA=cu130

%environment
    export PATH=/opt/conda/envs/torch/bin:/opt/conda/bin:$PATH
    export CONDA_DEFAULT_ENV=torch
    # Keep packages from ~/.local (your home dir is mounted in the container)
    # from leaking in and overriding the container's packages.
    export PYTHONNOUSERSITE=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
        git \
        vim \
        build-essential \
        cmake \
        unzip
    rm -rf /var/lib/apt/lists/*

    # ---- Miniconda ----
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p /opt/conda
    rm /tmp/miniconda.sh
    export PATH=/opt/conda/bin:$PATH

    # Use conda-forge only (no Anaconda defaults channel)
    cat > /opt/conda/.condarc <<'EOF'
channels:
  - conda-forge
channel_priority: strict
auto_activate_base: false
EOF

    # ---- Python environment ----
    conda create -y -n torch --override-channels -c conda-forge \
        python={{ PYTHON_VERSION }} \
        pip \
        numpy \
        scipy \
        pandas \
        scikit-learn \
        matplotlib \
        seaborn \
        plotly \
        tqdm \
        pyyaml \
        nltk \
        jupyterlab \
        ipykernel

    # ---- PyTorch (pip wheels from download.pytorch.org) ----
    /opt/conda/envs/torch/bin/pip install --no-cache-dir \
        torch torchvision \
        --index-url https://download.pytorch.org/whl/{{ TORCH_CUDA }}

    # Extra pip-only packages go here (they will use the torch installed above)
    /opt/conda/envs/torch/bin/pip install --no-cache-dir \
        transformers \
        datasets \
        accelerate \
        tensorboard

    # Shrink the image
    conda clean -afy

%test
    python -c "import torch, torchvision; print('torch', torch.__version__, '| cuda build', torch.version.cuda, '| torchvision', torchvision.__version__)"

%runscript
    # `apptainer run --nv pytorch.sif my_script.py` runs python with your args
    exec python "$@"

%labels
    Maintainer WSU CSE devteam
    Description PyTorch + Miniconda (conda-forge) for the CSE HPC cluster

%help
    PyTorch + Miniconda container for the WSU CSE HPC cluster.

    Default build targets the A100, L40S and H200 nodes (CUDA 13.0 wheels).
    For the P100 node, build with: --build-arg TORCH_CUDA=cu126

    Check the GPU is visible:
      apptainer exec --nv pytorch.sif python -c "import torch; print(torch.cuda.is_available(), torch.cuda.get_device_name(0))"

    Run a script:
      apptainer run --nv pytorch.sif my_script.py

    Jupyter (inside an salloc/srun session):
      apptainer exec --nv pytorch.sif jupyter lab --no-browser --ip=0.0.0.0
